# Postgres credentials used by docker-compose
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=plans_db

# DATABASE_URL used by the app; when running in compose, host should be 'db'
# Example: postgresql://user:password@db:5432/plans_db
DATABASE_URL=postgresql://user:password@db:5432/plans_db

ENV=development
SECRET_KEY=replace-with-a-secure-random-string
